{
  "buildCommand": "pnpm --filter @workspace/fileit run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/fileit/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}