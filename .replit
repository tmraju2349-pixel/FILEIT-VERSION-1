modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-aced7330-cf42-4d8e-abba-6eafbc737383"

[userenv]

[userenv.shared]
SUPABASE_STORAGE_BUCKET = "fileit"
SUPABASE_URL = "https://sahoekxpqvlckrlwvrpq.supabase.co"
VITE_STORAGE_PROVIDER = "supabase"
VITE_SUPABASE_STORAGE_BUCKET = "fileit"
VITE_SUPABASE_URL = "https://sahoekxpqvlckrlwvrpq.supabase.co"
